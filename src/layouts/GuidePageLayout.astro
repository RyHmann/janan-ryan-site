---
import Layout from './Layout.astro';
interface Frontmatter { title:string; description?:string; eyebrow?:string; intro?:string; }
interface Heading { depth:number; slug:string; text:string; }
const { frontmatter, headings=[] } = Astro.props as { frontmatter:Frontmatter; headings?:Heading[] };
const sections=headings.filter((heading)=>heading.depth===2);
---
<Layout title={`${frontmatter.title} | Janan & Ryan`} description={frontmatter.description}>
<section class="guide-hero"><p>{frontmatter.eyebrow ?? 'Wedding guide'}</p><h1>{frontmatter.title}</h1>{frontmatter.intro && <div>{frontmatter.intro}</div>}<span class="ornament">✦</span></section>
<section class="guide-layout"><aside><p>On this page</p><ol>{sections.map((section)=><li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></aside><article class="prose"><slot /></article></section>
</Layout>
<style>
.guide-hero{max-width:900px;margin:0 auto;text-align:center;padding:100px 24px 70px}.guide-hero p{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.13em;color:#a47e4f;margin:0 0 18px}.guide-hero h1{margin:0;color:var(--green);font:400 clamp(3.2rem,7vw,5.6rem)/1 var(--font-headline)}.guide-hero div{margin:24px auto 0;max-width:650px;color:var(--muted);font-size:1.1rem;line-height:1.7}.ornament{display:block;color:#b5996d;margin-top:35px}.guide-layout{width:min(1080px,calc(100% - 40px));margin:auto;display:grid;grid-template-columns:200px minmax(0,1fr);gap:70px}.guide-layout aside{padding-top:20px;color:var(--muted);font-size:.86rem}.guide-layout aside p{text-transform:uppercase;letter-spacing:.1em;font-size:.7rem;font-weight:700;color:var(--green)}.guide-layout ol{list-style:none;padding:0;margin:18px 0;display:grid;gap:10px}.guide-layout a:hover{color:var(--green);text-decoration:underline}.prose{border-top:1px solid var(--gold);padding-top:10px;color:var(--muted);line-height:1.75}.prose :global(h2){font:400 clamp(2rem,4vw,3.1rem)/1.15 var(--font-headline);color:var(--green);margin:70px 0 18px}.prose :global(h2:first-child){margin-top:25px}.prose :global(h3){font:400 1.5rem var(--font-headline);color:var(--green);margin:0 0 10px}.prose :global(p),.prose :global(ul),.prose :global(ol){margin:0 0 20px}.prose :global(blockquote){margin:25px 0;padding:28px;background:#fff;border-left:2px solid var(--gold);box-shadow:var(--surface-shadow)}.prose :global(blockquote p:last-child),.prose :global(blockquote ul:last-child){margin-bottom:0}.prose :global(a){color:var(--green);text-decoration:underline;text-decoration-color:var(--gold);text-underline-offset:3px}@media(max-width:720px){.guide-hero{padding:70px 20px 45px}.guide-layout{grid-template-columns:1fr;gap:20px}.guide-layout aside{border-top:1px solid var(--gold);padding-top:18px}.guide-layout ol{display:flex;flex-wrap:wrap;gap:12px}.prose :global(h2){margin-top:50px}}
</style>
