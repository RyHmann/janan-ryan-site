---
import { navLinks as defaultNavLinks } from '../data/site';
import '../styles/theme.css';
interface NavLink { href: string; label: string; }
interface Props { title: string; description?: string; navLinks?: NavLink[]; }
const { title, description = 'Janan and Ryan’s Wellington wedding.', navLinks = defaultNavLinks } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<html lang="en"><head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title></head>
<body><header class="site-header"><a class="wordmark" href={base}>Janan <span>&</span> Ryan</a><nav aria-label="Primary">{navLinks.map((link) => <a class:list={[{ active: path === link.href }]} href={`${base}${link.href.replace(/^\//, '')}`}>{link.label}</a>)}</nav></header><main><slot /></main><footer><a class="wordmark" href={base}>Janan <span>&</span> Ryan</a><p>Wellington, New Zealand</p></footer></body></html>
<style>
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:"Hanken Grotesk",sans-serif}a{color:inherit;text-decoration:none}.site-header{max-width:1200px;margin:auto;min-height:76px;padding:0 32px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e6ebe7}.wordmark{font:italic 600 clamp(1.35rem,2vw,1.75rem)/1 "Bodoni Moda",serif;color:var(--green)}.wordmark span{color:#b5996d}.site-header nav{display:flex;align-items:center;gap:28px}.site-header nav a{font-size:.72rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);padding:.7rem 0;border-bottom:2px solid transparent}.site-header nav a:hover,.site-header nav a.active{color:var(--green);border-color:var(--green)}.site-header nav a:last-child{padding:.75rem 1.25rem;border:0;background:var(--green);color:#fff;border-radius:3px}main{min-height:70vh}footer{margin-top:7rem;padding:3.5rem 1.5rem;text-align:center;background:var(--paper-deep);color:var(--muted)}footer p{margin:.8rem 0 0;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}@media(max-width:620px){.site-header{padding:0 20px;min-height:68px}.site-header nav{gap:15px}.site-header nav a{font-size:.63rem}.site-header nav a:nth-child(2){display:none}.site-header nav a:last-child{padding:.65rem .85rem}}
</style>
