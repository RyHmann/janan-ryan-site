---
import { navLinks as defaultNavLinks } from '../data/site';
import '../styles/theme.css';
interface NavLink { href: string; label: string; }
interface Props { title: string; description?: string; navLinks?: NavLink[]; }
const { title, description = 'Janan and Ryan’s Wellington wedding.', navLinks = defaultNavLinks } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<html lang="en"><head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title></head>
<body><header class="site-header"><a class="wordmark" href={base}>Janan <span>&</span> Ryan</a><nav class="desktop-nav" aria-label="Primary">{navLinks.map((link) => <a class:list={[{ active: path === link.href }]} href={`${base}${link.href.replace(/^\//, '')}`}>{link.label}</a>)}</nav><details class="mobile-nav"><summary aria-label="Open navigation">Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile primary">{navLinks.map((link) => <a class:list={[{ active: path === link.href }]} href={`${base}${link.href.replace(/^\//, '')}`}>{link.label}</a>)}</nav></details></header><main><slot /></main><footer><a class="wordmark" href={base}>Janan <span>&</span> Ryan</a><p>Wellington, New Zealand</p></footer></body></html>
<style>
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-body)}a{color:inherit;text-decoration:none}.site-header{max-width:1200px;margin:auto;min-height:76px;padding:0 32px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e6ebe7}.wordmark{font:400 clamp(1.35rem,2vw,1.75rem)/1 var(--font-headline);color:var(--green)}.wordmark span{color:#b5996d}.desktop-nav{display:flex;align-items:center;gap:28px}.site-header nav a{font-family:var(--font-label);font-size:.72rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);padding:.7rem 0;border-bottom:2px solid transparent}.site-header nav a:hover,.site-header nav a.active{color:var(--green);border-color:var(--green)}.site-header .desktop-nav a:last-child{padding:.75rem 1.25rem;border:0;background:var(--green);color:#fff;border-radius:3px}.mobile-nav{display:none}main{min-height:70vh}footer{margin-top:7rem;padding:3.5rem 1.5rem;text-align:center;background:var(--paper-deep);color:var(--muted)}footer p{font-family:var(--font-label);margin:.8rem 0 0;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}@media(max-width:620px){.site-header{position:relative;padding:0 20px;min-height:68px}.desktop-nav{display:none}.mobile-nav{display:block}.mobile-nav summary{display:flex;align-items:center;gap:8px;list-style:none;color:var(--green);font-family:var(--font-label);font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav summary span{font-size:1rem;line-height:1}.mobile-nav nav{position:absolute;top:calc(100% + 1px);right:20px;z-index:10;display:grid;min-width:190px;padding:8px;background:#fff;border:1px solid var(--line);box-shadow:var(--surface-shadow)}.mobile-nav nav a{padding:13px 14px;border:0}.mobile-nav nav a:hover,.mobile-nav nav a.active{background:var(--paper-deep);border:0}.mobile-nav nav a:last-child{margin-top:4px;background:var(--green);color:#fff;text-align:center;border-radius:3px}}
</style>
<style is:global>
  @media (max-width:760px) {
    .site-header{position:relative;padding:0 20px;min-height:68px}
    .site-header .desktop-nav{display:none!important}
    .site-header .mobile-nav{display:block!important}
    .mobile-nav summary{display:flex;align-items:center;gap:8px;list-style:none;color:var(--green);font-family:var(--font-label);font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
    .mobile-nav summary::-webkit-details-marker{display:none}
    .mobile-nav summary span{font-size:1rem;line-height:1}
    .mobile-nav nav{display:none!important;position:absolute;top:calc(100% + 1px);right:20px;z-index:10;min-width:190px;padding:8px;background:#fff;border:1px solid var(--line);box-shadow:var(--surface-shadow)}
    .mobile-nav[open] nav{display:grid!important}
    .mobile-nav nav a{padding:13px 14px;border:0}
    .mobile-nav nav a:hover,.mobile-nav nav a.active{background:var(--paper-deep);border:0}
    .site-header .mobile-nav nav a:last-child{margin-top:4px;padding:13px 14px!important;background:var(--green);color:#fff!important;text-align:center;border:0!important;border-radius:3px}
  }
</style>
