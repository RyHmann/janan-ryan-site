---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const images = {
  hero: 'https://wellingtonnz.bynder.com/transform/a2babfe9-9456-4806-a2d6-629f381f00fd/Cable-Car-02',
  weekend: 'https://images.squarespace-cdn.com/content/v1/634f5a7ad2fd55601804931a/ae12fe67-8d34-428d-8e1a-99f98d041e72/wellington-city-night-time.jpg',
};
---
<Layout title="Janan & Ryan | Wellington wedding" description="Everything you need for Janan and Ryan’s Wellington wedding.">
<section class="hero"><img src={images.hero} alt="Wellington Cable Car" /><div class="hero-overlay"><h1>Janan <span>&</span> Ryan</h1><p>Wellington, New Zealand</p></div></section>
<section class="intro"><p class="kicker">Save the date</p><h2>Come celebrate with us in Wellington.</h2><p>We’re so excited to welcome our favourite people to our corner of the world. Here’s everything you’ll need for a joyful weekend together.</p><div class="divider">✦</div></section>
<section class="split"><div><p class="kicker">The weekend</p><h2>Good people, good food, and a little Wellington weather.</h2><p>Find the practical details for the day, then explore our favourite ways to spend time in the city.</p><a href={`${base}wedding-details`}>Explore the details <span>→</span></a></div><img src={images.weekend} alt="Wellington city at night" /></section>
<section class="links" aria-label="Explore the wedding site"><a href={`${base}wedding-details`}><span>01</span><h3>Wedding details</h3><p>Times, places, and the essentials for the day.</p></a><a href={`${base}wellington-guide`}><span>02</span><h3>Travel</h3><p>Visas, arrival planning, and a place to stay.</p></a><a href={`${base}visitors-guide`}><span>03</span><h3>Visitors guide</h3><p>Our favourite ways to eat, drink, and explore.</p></a><a href={`${base}rsvp`}><span>04</span><h3>RSVP</h3><p>Your personal invitation link is ready when you are.</p></a></section>
</Layout>
<style>
.hero,.intro,.split,.links{width:min(1100px,calc(100% - 40px));margin-inline:auto}.hero{height:min(62vw,650px);min-height:420px;margin-top:38px;position:relative;overflow:hidden;border:1px solid var(--gold);border-radius:5px}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 45%,#10221dbf)}.hero img{width:100%;height:100%;object-fit:cover}.hero-overlay{position:absolute;z-index:1;left:8%;bottom:9%;color:#fff}.hero h1{font:400 clamp(3.5rem,9vw,7rem)/.9 var(--font-headline);margin:0}.hero h1 span{font-style:italic}.hero p,.kicker{font-family:var(--font-label);font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700}.intro{text-align:center;max-width:760px;padding:110px 0 90px}.kicker{color:#a47e4f;margin:0 0 18px}.intro h2,.split h2{font:400 clamp(2.5rem,5vw,4.3rem)/1.12 var(--font-headline);color:var(--green);margin:0}.intro>p:not(.kicker){color:var(--muted);line-height:1.7;font-size:1.1rem;margin:28px auto 0;max-width:650px}.divider{color:#b5996d;margin-top:45px;display:flex;gap:20px;align-items:center}.divider:before,.divider:after{content:"";height:1px;background:var(--gold);flex:1}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,9vw,130px);align-items:center}.split p:not(.kicker){line-height:1.7;color:var(--muted);max-width:440px}.split a{display:inline-block;margin-top:24px;color:var(--green);font-family:var(--font-label);font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em}.split a span{font-size:1.2rem;margin-left:8px}.split img{width:100%;height:480px;object-fit:cover;border:1px solid var(--gold);padding:5px}.links{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--gold);margin-top:120px}.links a{background:var(--paper);padding:36px;transition:.2s}.links a:hover{background:var(--peach)}.links span{font-family:var(--font-label);font-size:.75rem;color:#a47e4f}.links h3{font:400 1.8rem var(--font-headline);color:var(--green);margin:25px 0 10px}.links p{margin:0;color:var(--muted);line-height:1.5}@media(max-width:700px){.hero{height:95vw;min-height:0;margin-top:20px}.intro{padding:70px 0}.split{grid-template-columns:1fr}.split img{height:380px}.links{grid-template-columns:1fr;margin-top:70px}.links a{padding:26px}}
</style>
<style>
  .links a,.links a:hover,.links a:focus-visible{text-decoration:none}
  @media (min-width:851px){.links{grid-template-columns:repeat(4,1fr)}}
  @media (min-width:701px) and (max-width:850px){.links{grid-template-columns:repeat(2,1fr)}}
</style>
