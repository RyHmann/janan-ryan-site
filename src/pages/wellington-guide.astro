  },
  {
    name: 'Naumi Studio',
    type: 'Eclectic',
    area: 'Te Aro',
    description: 'Maximalist design meets heritage architecture. A sensory experience with rich colours and intricate details.',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCvUmed1qeU8QL8UsQiK3LCmPvkBiYOtG7c5pHVnP7YX2UUuJZALq4LtNHSfiePq7wqGsI3kWDm72me3IKmFaZ4vK5Mf_uIlXqui9u9umUrZzyboNYglGFkhv7CLTvPOUo05CglgRRWLgao_uSdPvVRqZ7y1MsrosR1-kT5swLVy2KPb6xc4RHVqwPIZPEaBqxtntn4MS584ye4FT-kl6laLoQSjeOJ6gBzmgohD7KbY5IigO5856pwTA',
  },
