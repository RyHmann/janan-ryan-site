# Server-only Supabase credentials. Never prefix these with PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# At least 32 random characters. Changing this signs out all RSVP sessions.
RSVP_SESSION_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to 90 days, but invitation expiry is always respected.
RSVP_SESSION_TTL_DAYS=90
